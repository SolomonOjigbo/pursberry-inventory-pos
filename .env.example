# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ---------- Runtime ----------
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ---------- Database ----------
# App connection. This role is NOT superuser and NOT the table owner, so Postgres
# Row-Level Security actually applies to it (see packages/db/prisma/migrations —
# owners and superusers BYPASS RLS by default, which silently defeats TEN-105).
DATABASE_URL=postgresql://pursberry_app:pursberry_dev@localhost:5433/pursberry_dev?schema=public

# Migration/owner connection, used only by `prisma migrate` and seeding.
DIRECT_DATABASE_URL=postgresql://pursberry:pursberry_dev@localhost:5433/pursberry_dev?schema=public

# ---------- Redis (session cache, sync queue, rate limiting) ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth (TEN-102) ----------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- Tax (POS-105) ----------
VAT_RATE_BPS=750          # 7.5% expressed in basis points
DEFAULT_CURRENCY=NGN

# ---------- Payment gateways (PAY-101 / PAY-102) — sandbox keys only ----------
MONIEPOINT_API_KEY=
MONIEPOINT_SECRET_KEY=
MONIEPOINT_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ---------- Desktop / offline (SYNC-101) ----------
# Path is resolved under Electron's userData dir when left blank.
SQLITE_PATH=
